// LALRPOP grammar for the PlainVulkan `.pv` language.
//
// This grammar consumes tokens from our hand-written `Lexer` (see
// lexer.rs) via LALRPOP's "external tokenizer" mechanism, rather than
// LALRPOP's built-in regex lexer -- this gives full control over numeric
// literal formats, string escapes, and comment stripping.
//
// Precedence is expressed the classic LALRPOP way: as a chain of
// left-recursive nonterminals, one per precedence level, from loosest
// (ternary/assignment) to tightest (primary). This is the same pattern
// LALRPOP's own documentation uses for its calculator examples, and it
// compiles to a conflict-free LALR(1) table for this grammar.

use std::str::FromStr;
use crate::ast::*;
use crate::token::Tok;
use crate::lexer::LexError;
use crate::ast_helpers::{stmt_from_expr, forinit_from_expr, forupdate_from_expr};

grammar;

extern {
    type Location = usize;
    type Error = LexError;

    enum Tok {
        "var" => Tok::KwVar,
        "let" => Tok::KwLet,
        "const" => Tok::KwConst,
        "function" => Tok::KwFunction,
        "return" => Tok::KwReturn,
        "if" => Tok::KwIf,
        "elif" => Tok::KwElif,
        "else" => Tok::KwElse,
        "while" => Tok::KwWhile,
        "for" => Tok::KwFor,
        "break" => Tok::KwBreak,
        "continue" => Tok::KwContinue,
        "true" => Tok::KwTrue,
        "false" => Tok::KwFalse,
        "null" => Tok::KwNull,

        "{" => Tok::LBrace,
        "}" => Tok::RBrace,
        "(" => Tok::LParen,
        ")" => Tok::RParen,
        "[" => Tok::LBracket,
        "]" => Tok::RBracket,
        "," => Tok::Comma,
        ";" => Tok::Semi,
        "." => Tok::Dot,
        "::" => Tok::ColonColon,
        ":" => Tok::Colon,
        "?" => Tok::Question,

        "=" => Tok::Assign,
        "+=" => Tok::PlusEq,
        "-=" => Tok::MinusEq,
        "*=" => Tok::StarEq,
        "/=" => Tok::SlashEq,
        "%=" => Tok::PercentEq,

        "==" => Tok::EqEq,
        "!=" => Tok::NotEq,
        "<" => Tok::Lt,
        ">" => Tok::Gt,
        "<=" => Tok::LtEq,
        ">=" => Tok::GtEq,

        "&&" => Tok::AndAnd,
        "||" => Tok::OrOr,
        "!" => Tok::Bang,

        "+" => Tok::Plus,
        "-" => Tok::Minus,
        "*" => Tok::Star,
        "/" => Tok::Slash,
        "%" => Tok::Percent,
        "~" => Tok::Tilde,

        "int" => Tok::Int(<i64>),
        "float" => Tok::Float(<f64>),
        "string" => Tok::Str(<String>),
        "ident" => Tok::Ident(<String>),
    }
}

// ---------------------------------------------------------------------
// Helper macros
// ---------------------------------------------------------------------

// Comma-separated list of T, allowing an optional trailing comma.
Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <last:T?> => {
        match last {
            Some(x) => { v.push(x); v },
            None => v,
        }
    }
};

// ---------------------------------------------------------------------
// Program / items
// ---------------------------------------------------------------------

pub Program: Program = {
    <stmts:Stmt*> => Program { stmts }
};

FunctionDecl: FunctionDecl = {
    <l:@L> "function" <name:"ident"> "(" <params:Comma<"ident">> ")" <body:Block> <r:@R> =>
        FunctionDecl { name, params, body, span: (l, r) },
};

Block: Block = {
    <l:@L> "{" <stmts:Stmt*> "}" <r:@R> => Block { stmts, span: (l, r) },
};

// ---------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------

// Assignment statements and plain expression statements both start by
// parsing a full `Expr` (assignment is folded into the Expr precedence
// chain itself -- see AssignExpr below), so there is exactly ONE grammar
// path here. Which `Stmt` variant comes out is decided afterwards, by
// pattern-matching the parsed Expr, not by two competing grammar
// alternatives -- this is what keeps the LALR(1) table conflict-free.
Stmt: Stmt = {
    <s:VarDeclStmt> => Stmt::VarDecl(s),
    <l:@L> <e:Expr> ";" <r:@R> => stmt_from_expr(e, (l, r)),
    <s:IfStmt> => Stmt::If(s),
    <s:WhileStmt> => Stmt::While(s),
    <s:ForStmt> => Stmt::For(s),
    <l:@L> "break" ";" <r:@R> => Stmt::Break((l, r)),
    <l:@L> "continue" ";" <r:@R> => Stmt::Continue((l, r)),
    <s:ReturnStmt> => Stmt::Return(s),
    <b:Block> => Stmt::Block(b),
    <f:FunctionDecl> => Stmt::Function(f),
};

DeclKw: DeclKind = {
    "var" => DeclKind::Var,
    "let" => DeclKind::Let,
};

VarDeclStmt: VarDeclStmt = {
    <l:@L> <kind:DeclKw> <name:"ident"> <init:("=" <Expr>)?> ";" <r:@R> =>
        VarDeclStmt { kind, name, init, span: (l, r) },
    <l:@L> "const" <name:"ident"> "=" <init:Expr> ";" <r:@R> =>
        VarDeclStmt { kind: DeclKind::Const, name, init: Some(init), span: (l, r) },
};

AssignOpTok: AssignOp = {
    "=" => AssignOp::Assign,
    "+=" => AssignOp::AddAssign,
    "-=" => AssignOp::SubAssign,
    "*=" => AssignOp::MulAssign,
    "/=" => AssignOp::DivAssign,
    "%=" => AssignOp::ModAssign,
};

IfStmt: IfStmt = {
    <l:@L> "if" "(" <cond:Expr> ")" <then_block:Block>
        <elifs:ElifClause*>
        <else_block:("else" <Block>)?> <r:@R> =>
        IfStmt { cond, then_block, elifs, else_block, span: (l, r) },
};

ElifClause: (Expr, Block) = {
    "elif" "(" <cond:Expr> ")" <b:Block> => (cond, b),
};

WhileStmt: WhileStmt = {
    <l:@L> "while" "(" <cond:Expr> ")" <body:Block> <r:@R> =>
        WhileStmt { cond, body, span: (l, r) },
};

// for (init; cond; update) { body }
// init/update reuse the same "assign-or-expr" narrowing as top-level
// statements, just without consuming their own trailing ';' (the for-loop
// syntax supplies those explicitly).
ForStmt: ForStmt = {
    <l:@L> "for" "(" <init:ForInit> ";" <cond:Expr?> ";" <update:ForUpdate> ")" <body:Block> <r:@R> =>
        ForStmt { init, cond, update, body, span: (l, r) },
};

ForInit: ForInit = {
    <l:@L> <kind:DeclKw> <name:"ident"> <init:("=" <Expr>)?> <r:@R> =>
        ForInit::VarDecl(VarDeclStmt { kind, name, init, span: (l, r) }),
    <l:@L> <e:Expr> <r:@R> => forinit_from_expr(e, (l, r)),
    => ForInit::Empty,
};

ForUpdate: ForUpdate = {
    <l:@L> <e:Expr> <r:@R> => forupdate_from_expr(e, (l, r)),
    => ForUpdate::Empty,
};

ReturnStmt: ReturnStmt = {
    <l:@L> "return" <value:Expr?> ";" <r:@R> => ReturnStmt { value, span: (l, r) },
};

// ---------------------------------------------------------------------
// Expressions (precedence, loosest to tightest):
//   assignment (right-assoc)  >  ternary  >  ||  >  &&  >  ==, !=
//   >  <, >, <=, >=  >  +, -  >  *, /, %
//   >  unary (-, !, ~)  >  postfix (call, index, member, scope)  >  primary
//
// Assignment sits at the very top of the chain, folded directly into the
// Expr grammar rather than living in a separate, competing statement-level
// rule. This is what keeps the LALR(1) table conflict-free: there is only
// ever ONE place in the whole grammar where the parser must decide "was
// that a complete expression, or the start of `target = ...`?", so no
// LALR state-merging can smear that decision into unrelated contexts
// (array elements, call arguments, if-conditions, ...).
// ---------------------------------------------------------------------

pub Expr: Expr = AssignExpr;

// Right-associative: `a = b = 5` parses as `a = (b = 5)`.
//
// The target is restricted to `Postfix` (identifiers plus call/index/
// member/scope chains) rather than the full `Ternary` -- deliberately
// narrower, the same way C restricts assignment's left-hand side to
// `unary-expression` rather than `conditional-expression`. Two things
// would go wrong with a wider target:
//   1. It would make `a ? b : c = d` genuinely ambiguous (does `=`
//      belong to the ternary's false branch, or to the whole ternary?),
//      which LALRPOP correctly refuses to build.
//   2. It's semantically pointless anyway: `LValue::from_expr` only
//      accepts Ident/Index/Member shapes, so a target that could parse
//      as `a + b` or `a ? b : c` could never survive validation.
// `Postfix` still admits `Call`/`Scope` shapes (e.g. `Pv::Foo() = 5`),
// which is what lets the fallible action below reject them with a clear
// "invalid assignment target" diagnostic instead of a raw parse error.
AssignExpr: Expr = {
    <l:@L> <target:Postfix> <op:AssignOpTok> <value:AssignExpr> <r:@R> =>? {
        let lvalue = LValue::from_expr(target)
            .map_err(|span| lalrpop_util::ParseError::User {
                error: LexError::InvalidAssignmentTarget(span.0, span.1),
            })?;
        Ok(Expr::Assign(Box::new(lvalue), op, Box::new(value), (l, r)))
    },
    Ternary,
};

Ternary: Expr = {
    <l:@L> <c:LogicalOr> "?" <t:Expr> ":" <f:Expr> <r:@R> =>
        Expr::Ternary(Box::new(c), Box::new(t), Box::new(f), (l, r)),
    LogicalOr,
};

LogicalOr: Expr = {
    <l:@L> <a:LogicalOr> "||" <b:LogicalAnd> <r:@R> =>
        Expr::Binary(BinaryOp::Or, Box::new(a), Box::new(b), (l, r)),
    LogicalAnd,
};

LogicalAnd: Expr = {
    <l:@L> <a:LogicalAnd> "&&" <b:Equality> <r:@R> =>
        Expr::Binary(BinaryOp::And, Box::new(a), Box::new(b), (l, r)),
    Equality,
};

Equality: Expr = {
    <l:@L> <a:Equality> "==" <b:Relational> <r:@R> =>
        Expr::Binary(BinaryOp::Eq, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Equality> "!=" <b:Relational> <r:@R> =>
        Expr::Binary(BinaryOp::Ne, Box::new(a), Box::new(b), (l, r)),
    Relational,
};

Relational: Expr = {
    <l:@L> <a:Relational> "<" <b:Additive> <r:@R> =>
        Expr::Binary(BinaryOp::Lt, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Relational> ">" <b:Additive> <r:@R> =>
        Expr::Binary(BinaryOp::Gt, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Relational> "<=" <b:Additive> <r:@R> =>
        Expr::Binary(BinaryOp::Le, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Relational> ">=" <b:Additive> <r:@R> =>
        Expr::Binary(BinaryOp::Ge, Box::new(a), Box::new(b), (l, r)),
    Additive,
};

Additive: Expr = {
    <l:@L> <a:Additive> "+" <b:Multiplicative> <r:@R> =>
        Expr::Binary(BinaryOp::Add, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Additive> "-" <b:Multiplicative> <r:@R> =>
        Expr::Binary(BinaryOp::Sub, Box::new(a), Box::new(b), (l, r)),
    Multiplicative,
};

Multiplicative: Expr = {
    <l:@L> <a:Multiplicative> "*" <b:UnaryExpr> <r:@R> =>
        Expr::Binary(BinaryOp::Mul, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Multiplicative> "/" <b:UnaryExpr> <r:@R> =>
        Expr::Binary(BinaryOp::Div, Box::new(a), Box::new(b), (l, r)),
    <l:@L> <a:Multiplicative> "%" <b:UnaryExpr> <r:@R> =>
        Expr::Binary(BinaryOp::Mod, Box::new(a), Box::new(b), (l, r)),
    UnaryExpr,
};

UnaryExpr: Expr = {
    <l:@L> "-" <e:UnaryExpr> <r:@R> => Expr::Unary(UnaryOp::Neg, Box::new(e), (l, r)),
    <l:@L> "!" <e:UnaryExpr> <r:@R> => Expr::Unary(UnaryOp::Not, Box::new(e), (l, r)),
    <l:@L> "~" <e:UnaryExpr> <r:@R> => Expr::Unary(UnaryOp::BitNot, Box::new(e), (l, r)),
    Postfix,
};

Postfix: Expr = {
    <l:@L> <b:Postfix> "(" <args:Comma<Expr>> ")" <r:@R> =>
        Expr::Call(Box::new(b), args, (l, r)),
    <l:@L> <b:Postfix> "[" <i:Expr> "]" <r:@R> =>
        Expr::Index(Box::new(b), Box::new(i), (l, r)),
    <l:@L> <b:Postfix> "." <m:"ident"> <r:@R> =>
        Expr::Member(Box::new(b), m, (l, r)),
    <l:@L> <b:Postfix> "::" <m:"ident"> <r:@R> =>
        Expr::Scope(Box::new(b), m, (l, r)),
    Primary,
};

Primary: Expr = {
    <l:@L> <n:"int"> <r:@R> => Expr::IntLiteral(n, (l, r)),
    <l:@L> <n:"float"> <r:@R> => Expr::FloatLiteral(n, (l, r)),
    <l:@L> <s:"string"> <r:@R> => Expr::StringLiteral(s, (l, r)),
    <l:@L> "true" <r:@R> => Expr::BoolLiteral(true, (l, r)),
    <l:@L> "false" <r:@R> => Expr::BoolLiteral(false, (l, r)),
    <l:@L> "null" <r:@R> => Expr::NullLiteral((l, r)),
    <l:@L> <id:"ident"> <r:@R> => Expr::Ident(id, (l, r)),
    "(" <e:Expr> ")" => e,
    <l:@L> "[" <elems:Comma<Expr>> "]" <r:@R> => Expr::ArrayLiteral(elems, (l, r)),
};
