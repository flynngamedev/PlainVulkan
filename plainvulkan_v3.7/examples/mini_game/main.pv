// mini_game -- "Cube Collector". A small but complete example tying
// together window/camera setup, keyboard movement, simple distance-based
// collision, lighting, and UI/HUD text. Move with WASD, collect the
// yellow cubes, avoid running out of time.
//
//   pv run examples/mini_game

function distance(ax, ay, az, bx, by, bz) {
    var dx = ax - bx;
    var dy = ay - by;
    var dz = az - bz;
    return (dx * dx + dy * dy + dz * dz);
}

function randish(seed) {
    // Tiny deterministic pseudo-random helper (no Pv::Random in the
    // engine command reference) -- good enough to scatter pickups.
    var v = (seed * 928371) % 1000;
    if (v < 0) {
        v = -v;
    }
    return (v / 1000.0) * 10.0 - 5.0;
}

Pv::Init();
var opened = Pv::CreateWindow(1024, 768, "Cube Collector");
if (!opened) {
    Pv::LogError("Could not open a window -- is a display connected?");
    Pv::Shutdown();
} else {

Pv::SetAmbient(1, 1, 1, 0.35);
Pv::AddDirectionalLight(-0.3, -1, -0.2, 1, 1, 0.95, 0.85);

var playerMesh = Pv::CreateCube(0.6);
var pickupMesh = Pv::CreateCube(0.35);

var playerX = 0.0;
var playerZ = 0.0;
const SPEED = 4.0;
const PICKUP_RADIUS = 0.7;
const PICKUP_COUNT = 6;

var pickupX = [];
var pickupZ = [];
var pickupAlive = [];
for (var p = 0; p < PICKUP_COUNT; p += 1) {
    pickupX[p] = randish(p * 3 + 1);
    pickupZ[p] = randish(p * 7 + 5);
    pickupAlive[p] = true;
}

var score = 0;
var timeLeft = 30.0;
var gameOver = false;

while (Pv::IsWindowOpen()) {
    Pv::BeginFrame();
    Pv::Clear(0x14141f);

    var dt = Pv::GetDeltaTime();

    if (!gameOver) {
        timeLeft -= dt;
        if (timeLeft <= 0) {
            timeLeft = 0;
            gameOver = true;
        }

        var moveX = 0.0;
        var moveZ = 0.0;
        // Camera sits at (x, 6, z-6) looking at the player, so view-forward
        // is +Z and view-right is -X. WASD is in *view* space, not raw axes.
        if (Pv::IsKeyDown(87)) { moveZ += 1.0; }  // W — into the screen
        if (Pv::IsKeyDown(83)) { moveZ -= 1.0; }  // S
        if (Pv::IsKeyDown(65)) { moveX += 1.0; }  // A — left
        if (Pv::IsKeyDown(68)) { moveX -= 1.0; }  // D — right

        playerX += moveX * SPEED * dt;
        playerZ += moveZ * SPEED * dt;

        for (var i = 0; i < PICKUP_COUNT; i += 1) {
            if (pickupAlive[i]) {
                var d = distance(playerX, 0, playerZ, pickupX[i], 0, pickupZ[i]);
                if (d < PICKUP_RADIUS * PICKUP_RADIUS) {
                    pickupAlive[i] = false;
                    score += 1;
                }
            }
        }
    }

    Pv::SetCamera(playerX, 6, playerZ - 6);
    Pv::LookAt(playerX, 0, playerZ);

    Pv::DrawMesh(playerMesh, playerX, 0, playerZ);
    for (var k = 0; k < PICKUP_COUNT; k += 1) {
        if (pickupAlive[k]) {
            Pv::DrawMeshEx(pickupMesh, pickupX[k], 0, pickupZ[k], 0, timeLeft * 2, 0, 1.0);
        }
    }

    Pv::DrawText("Score: " + score, 20, 20, 0xFFFFFF);
    Pv::DrawText("Time: " + timeLeft, 20, 40, 0xFFFFFF);
    if (gameOver) {
        Pv::DrawText("TIME UP", 20, 70, 0xFF5555);
    }
    Pv::DrawText("WASD to move, collect the cubes", 20, 730, 0xAAAAAA);

    if (Pv::IsKeyPressed(256)) { // Escape
        Pv::CloseWindow();
    }

    Pv::EndFrame();
}

Pv::Shutdown();
}
